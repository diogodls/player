# ======================================================
# Variáveis de ambiente — Backend
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no git
# ======================================================

# Banco de dados
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=player
DATABASE_PASSWORD=player
DATABASE_NAME=player

# JWT — OBRIGATÓRIO substituir por strings aleatórias longas em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_STRING_ALEATORIA_LONGA_64_CHARS
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRA_STRING_ALEATORIA_LONGA_64_CHARS

# URL do frontend (para CORS)
FRONTEND_URL=https://seudominio.com

# Ambiente
NODE_ENV=production

# Porta do servidor
PORT=3000
